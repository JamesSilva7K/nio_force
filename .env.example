# ---------------------------------------------------------------------------
# Nio — variáveis de ambiente
# Copie para `.env.local` (desenvolvimento) ou configure no painel da Vercel.
# NUNCA versione este arquivo com valores reais.
# ---------------------------------------------------------------------------

# --- Telegram (obrigatório) -------------------------------------------------
# Token gerado pelo @BotFather.
TELEGRAM_BOT_TOKEN=
# Chat ID do administrador supremo (envie /id para o bot para descobrir).
# Aceita vários, separados por vírgula.
TELEGRAM_ADMIN_ID=
# Super-administrador(es) — podem aprovar ações sensíveis (mudar nº do site,
# converter/perder lead). Se vazio, QUALQUER admin tem poderes totais.
# Para ambientes com múltiplos admins, recomendamos configurar este campo.
# Aceita vários IDs separados por vírgula.
TELEGRAM_SUPERADMIN_ID=
# Segredo enviado pelo Telegram no cabeçalho x-telegram-bot-api-secret-token.
# Gere com: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Opcional: segredo dedicado à assinatura dos botões (padrão: o do webhook).
TELEGRAM_CALLBACK_SECRET=

# --- Criptografia das PII (obrigatório) -------------------------------------
# 32 bytes em base64. Gere com: openssl rand -base64 32
LEAD_ENCRYPTION_KEY=
# Sal para hash de IP e índice cego (padrão: LEAD_ENCRYPTION_KEY).
IP_HASH_SALT=

# --- Armazenamento (obrigatório na Vercel) ----------------------------------
# Plano gratuito da Upstash: https://upstash.com (Redis → REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Verificação real de conta WhatsApp (opcional) --------------------------# Sem isso, o bot faz só a análise local (DDD, nono dígito, UF, padrões
# suspeitos) e NUNCA afirma que a conta existe.
# Com isso, o endpoint é chamado com POST {"numero":"5511..."} e deve responder
# {"existe": true|false}.
WHATSAPP_VERIFY_URL=
WHATSAPP_VERIFY_TOKEN=

# --- Site -------------------------------------------------------------------
# Número de WhatsApp padrão (E.164 só dígitos). Pode ser trocado pelo Telegram.
DEFAULT_WHATSAPP=5511953866646
# URL pública, usada para registrar o webhook do Telegram.
SITE_URL=https://seu-projeto.vercel.app
# Domínios autorizados (anti-clonagem). Vazio = aceita qualquer host.
ALLOWED_HOSTS=
# --- Vercel Edge Config (persistência no plano gratuito) -------------------
# Alternativa gratuita ao Redis para salvar número WhatsApp, título e favicon.
# Configure em: vercel.com → Storage → Edge Config → Create → Connect Project.
# Após criar e conectar, as 3 variáveis abaixo aparecem automaticamente no projeto.
#
# EDGE_CONFIG            → gerado pela Vercel ao conectar o Edge Config
# VERCEL_EDGE_CONFIG_ID  → ID do store (ex: ecfg_xxxxxxxxxxxxxxxx)
# VERCEL_API_TOKEN       → crie em vercel.com/account/tokens (scope: Full Account)
EDGE_CONFIG=
VERCEL_EDGE_CONFIG_ID=
VERCEL_API_TOKEN=

# --- Token para chamar /api/telegram/setup uma única vez (depois pode remover) ---
# Token para chamar /api/telegram/setup uma única vez (depois pode remover).
ADMIN_API_TOKEN=

# --- Google Ads & Google Tag Manager (opcional) ------------------------------
# ID público da tag de conversão. Se vazio, usa AW-18517052475 do código.
VITE_GOOGLE_ADS_ID=
# ID público do Google Tag Manager. Se vazio, usa GTM-579VX4DF do código.
VITE_GTM_ID=
